# Copy this file to .env, then replace every placeholder with a real secret.
# Never commit the resulting .env file.

# Required by ai_investigator.py and the OpenAI node in the RocketRide pipeline.
OPENAI_API_KEY=

# Optional override for the pipeline when it is started outside the Python
# runner. The runner maps OPENAI_API_KEY into this namespace automatically.
ROCKETRIDE_OPENAI_KEY=

# Required only when running rocketrider_runner.py against RocketRide cloud.
ROCKETRIDE_URI=https://api.rocketride.ai
ROCKETRIDE_APIKEY=
